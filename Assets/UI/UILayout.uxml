<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Button text="Restart" name="RestartButton" style="top: 40%; position: absolute; align-self: center; padding-right: 18px; padding-left: 18px; font-size: 24px; color: rgb(0, 247, 86); background-color: rgba(188, 188, 188, 0); border-left-color: rgb(0, 247, 86); border-right-color: rgb(0, 247, 86); border-top-color: rgb(0, 247, 86); border-bottom-color: rgb(0, 247, 86); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px;"/>
    <ui:Label text="Score: 0 " name="ScoreLabel" style="color: rgb(255, 255, 255); left: 35px; top: 20px;"/>
