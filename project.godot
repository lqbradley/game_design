; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

ss2d/version="3.3.1"

[application]

config/name="Detect-Octo"
run/main_scene="uid://dkpjrh3w21xep"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
DialogueManager="*uid://c3rodes2l3gxb"
GameManager="*uid://ccebd342uwhc5"

[dialogue_manager]

runtime/balloon_path="res://dialogue/test_balloon/balloon.tscn"

[display]

window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[global_group]

to_player=""
to_object="objects that octopus can use to pull itself somewhere"
pushable_object=""
pickup_able=""
activate_able=""
exit=""
spawn_points=""
player=""

